# ==============================================================================
# AIC 2026 Multimodal Video Retrieval — Production Environment Configuration
# Copy this file to .env and configure values before starting the container:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Host Networking & Persistence Paths
# ------------------------------------------------------------------------------
AIC_BIND_IP=127.0.0.1
AIC_PORT=8000

# Host directory paths for persistent data, models, cache, and logs
# Standard recommended deployment layout: /opt/aic/{data,models,cache,logs}
AIC_DATA_DIR=./data
AIC_MODELS_DIR=./models
AIC_CACHE_DIR=./cache
AIC_LOGS_DIR=./logs

# Container internal path configuration
VIDEO_PROCESSED_ROOT=/data/processed
MODEL_CACHE_DIR=/models
HF_HOME=/cache/huggingface
TRANSFORMERS_CACHE=/cache/huggingface
TORCH_HOME=/cache/torch

# CORS allowed origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000

# ------------------------------------------------------------------------------
# 2. Visual Frame Sampling Optimization (RECOMMENDED CONFIGURATION)
# ------------------------------------------------------------------------------
VISUAL_SAMPLING_MODE=sparse_shot
VISUAL_GLOBAL_SAMPLE_SECONDS=5.0
VISUAL_DEDUP_ENABLED=true
VISUAL_DEDUP_THRESHOLD=0.97

# Query-Time Local Dense Refinement Settings
# NOTE: The local refinement module is not yet wired into ConfiguredSearch;
# these values preserve the intended deployment contract for that integration.
LOCAL_REFINE_ENABLED=true
LOCAL_REFINE_WINDOW_SECONDS=10.0
LOCAL_REFINE_INTERVAL_SECONDS=0.5
LOCAL_REFINE_MAX_REGIONS=5

# --- ROLLBACK CONFIGURATION (Uncomment to restore legacy uniform 1.0s behavior) ---
# VISUAL_SAMPLING_MODE=legacy
# VISUAL_DEDUP_ENABLED=false
# LOCAL_REFINE_ENABLED=false

# ------------------------------------------------------------------------------
# 3. Model & Feature Flags
# ------------------------------------------------------------------------------
SIGLIP_ENABLED=true
SIGLIP2_MODEL=google/siglip2-base-patch16-224
SIGLIP_LONG_TEXT_MODE=chunk_mean
SIGLIP_TEXT_MAX_LENGTH=64
SIGLIP_TEXT_CHUNK_STRIDE=8
SIGLIP_TEXT_MAX_CHUNKS=8

E5_ENABLED=true
BM25_ENABLED=true

# Optical Character Recognition (OCR) Settings
OCR_BACKEND=auto
OCR_CPU_BACKEND=tesseract
OCR_GPU_BACKEND=paddleocr
OCR_PADDLE_MIN_CONFIDENCE=0.50

# Speech Recognition (ASR) Settings
FASTER_WHISPER_MODEL=small

# Query Refiner & Reranker Settings
QUERY_REFINER_ENABLED=true
QUERY_REFINER_BACKEND=auto
QUERY_REFINER_MODEL=Qwen/Qwen2.5-1.5B-Instruct
QUERY_REFINER_MAX_VISUAL_VARIANTS=4
QUERY_REFINER_CACHE_ENABLED=true
QUERY_REFINER_RRF_K=60
DEBUG_QUERY_PLAN=false

RERANKER_ENABLED=true
TRAKE_COHERENCE_MODE=diagnostic

# Offline Execution Flags (Set to 1 when pre-cached weights are mounted)
HF_HUB_OFFLINE=0
TRANSFORMERS_OFFLINE=0

# ------------------------------------------------------------------------------
# 4. Secrets & External Credentials (OPTIONAL / PLACEHOLDERS ONLY)
# ------------------------------------------------------------------------------
OPENAI_API_KEY=
HF_TOKEN=
