# Build context excludes runtime data, model weights, tests/docs/experiments,
# and all untracked work from the deployment image.

# Version control
.git
.gitignore
.github
.git/**

# Python environment and caches
.runtime/
.tools/
.venv
venv
__pycache__
*.pyc
*.pyo
*.pyd
.pytest_cache
.ruff_cache
.coverage
htmlcov
.cache

# Environment secrets and credentials
.env
.env.*
*.env
credentials/
secrets/
*.pem
*.key
*.token

# Runtime & Local persistent directories
data/
/data/
models/
artifacts/
logs/
cache/
contact_sheets/
contact_sheets_sparse/

# Test & Validation data
validation/
eval/
tests/
docs/
paper/
PDF/
figures/
*.tex
*.bib
*.pdf

# Experiment and benchmark artifacts
results/
artifacts/
downloads/

# Archives & Temporary files
*.log
*.tmp
*.tar
*.tar.gz
*.zip
*.7z
*.db
*.sqlite
*.sqlite3

# Nested legacy/external projects
AIC2024/
AIC2025-VideoRetrieval-float97/
AI-Challenge-2026-Video-Retrieval-Panel/
liệu/
tools/
# Allow only the required runtime validator from scripts/
scripts/*
!scripts/
!scripts/validate_gpu_ingest.py

# Frontend development extras
node_modules/
