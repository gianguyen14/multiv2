# AIC Docker image policy
# Never send runtime data, model weights, secrets, credentials, or research artifacts.
# The !.env.example exception is intentionally absent.

# Version control
.git
.gitignore
.github
.git/**

# Python environment and caches
.venv
venv
__pycache__
*.pyc
*.pyo
*.pyd
.pytest_cache
.ruff_cache
.coverage
htmlcov
.cache

# Environment secrets and credentials
.env
.env.*
*.env
credentials/
secrets/
*.pem
*.key
*.token

# Runtime & Local persistent directories
data/
models/
artifacts/
logs/
cache/
contact_sheets/
contact_sheets_sparse/

# Test & Validation data
validation/
eval/
tests/
docs/
paper/
PDF/
figures/
*.tex
*.bib
*.pdf

# Experiment and benchmark artifacts
results/

# Archives & Temporary files
*.log
*.tmp
*.tar
*.tar.gz
*.zip
*.7z
*.db
*.sqlite
*.sqlite3
input.zip
input.zip.aria2
qa_output.txt
trace_output.txt

# Nested legacy/external projects
AIC2024/
